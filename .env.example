# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-private

# University Email Domain Validation
# Example: 'student.edu' or multiple separated by comma 'student.edu,university.edu'
NEXT_PUBLIC_UNIVERSITY_EMAIL_DOMAIN=student.edu

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Professional Email Service (Resend - Free 3,000 emails/month)
# Get your API key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="UniMate KFUEIT <onboarding@resend.dev>"

# SMTP Email Service (Gmail SMTP fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="UniMate KFUEIT <noreply@kfueit.edu.pk>"

# Cloudflare R2 Storage Configuration (10 GB Free)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=unimate-files
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

